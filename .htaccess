RewriteEngine On

# Redirect legacy .html URLs to their clean equivalents
RewriteRule ^index-shop\.html$ /shop [R=301,L,QSA]
RewriteRule ^cart\.html$ /cart [R=301,L,QSA]
RewriteRule ^checkout\.html$ /checkout [R=301,L,QSA]
RewriteRule ^payment\.html$ /payment [R=301,L,QSA]
RewriteRule ^orders\.html$ /orders [R=301,L,QSA]
RewriteRule ^account\.html$ /account [R=301,L,QSA]
RewriteRule ^login\.html$ /login [R=301,L,QSA]
RewriteRule ^register\.html$ /register [R=301,L,QSA]
RewriteRule ^contact\.html$ /contact [R=301,L,QSA]
RewriteRule ^admin\.html$ /admin [R=301,L,QSA]
RewriteRule ^product-detail\.html$ /product [R=301,L,QSA]
RewriteRule ^index\.html$ / [R=301,L,QSA]

# Never rewrite real files/directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Clean public routes
RewriteRule ^$ index.html [L]
RewriteRule ^home/?$ index.html [L]
RewriteRule ^shop/?$ index-shop.html [L,QSA]
RewriteRule ^cart/?$ cart.html [L]
RewriteRule ^checkout/?$ checkout.html [L]
RewriteRule ^payment/?$ payment.html [L]
RewriteRule ^orders/?$ orders.html [L]
RewriteRule ^account/?$ account.html [L]
RewriteRule ^login/?$ login.html [L,QSA]
RewriteRule ^register/?$ register.html [L,QSA]
RewriteRule ^contact/?$ contact.html [L]
RewriteRule ^admin/?$ admin.html [L]
RewriteRule ^product/?$ product-detail.html [L,QSA]
